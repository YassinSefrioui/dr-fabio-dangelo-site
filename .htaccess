# drfabiodangelo.com — Apache configuration
# Canonical host: https://www.drfabiodangelo.com

# ---------------------------------------------------------------------------
# Canonical URL enforcement
# ---------------------------------------------------------------------------
RewriteEngine On

# 1. Force HTTPS (also lifts non-www to www in the same hop)
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://www.drfabiodangelo.com/$1 [R=301,L]

# 2. Force www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.drfabiodangelo.com/$1 [R=301,L]

# 3. Strip index.html -> directory URL (root and /en/, /fr/, /it/)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# BEGIN legacy-slug redirects (generated by tools/build-htaccess.py)
# Task 4.1 moved EN/FR/IT off the Spanish filenames. Keep these permanently:
# old inbound links and anything still in the index rely on them.

